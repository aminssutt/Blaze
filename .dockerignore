# Build context for backend/Dockerfile and frontend/Dockerfile (both use the
# repo root as context — the frontend prebuild reads contracts/ and data/, and
# the backend resolves REPO_ROOT to /app).

# VCS & agent scratch
.git
.github
.claude
.playwright-mcp

# Python
**/__pycache__
**/*.py[cod]
.venv
venv
.pytest_cache
*.egg-info
.mypy_cache
.ruff_cache

# Node
node_modules
**/node_modules
frontend/.next
frontend/out

# Generated fixture copies — regenerated by the prebuild hook inside the image
frontend/public/mocks
frontend/public/data

# Secrets (values come from Dokploy env vars, never from a baked .env)
.env
*.pem

# Not needed to run the replay demo
video/
docs/
demo/
design/*.md
*.png
*.mp4
snap2.yml
artifacts/
.stack-logs/

# Model weights & generated audio
models/
whisper-models/
*.gguf
*.safetensors
*.onnx
speech/tts/piper-voices/
speech/tts/output/
