# BLAZE environment — copy to .env, never commit real secrets.

# Model and inference
GEMMA_MODEL_ID=
HF_TOKEN=
VLLM_BASE_URL=http://localhost:8000
# Local-only placeholder for the vLLM server, NOT an external AI-provider key
VLLM_API_KEY=local-only-placeholder

# NASA FIRMS (free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=

# Scenario
SCENARIO_ID=wildfire-demo-01
DEMO_MODE=true
USE_CACHED_EXTERNAL_DATA=true
NETWORK_MODE=online

# Speech
WHISPER_MODEL_SIZE=small
WHISPER_LANGUAGE=fr
# Piper voice model (see speech/tts/README.md for download instructions)
PIPER_VOICE_PATH=speech/tts/piper-voices/fr_FR-siwis-medium.onnx

# Backend/frontend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_PORT=3000
